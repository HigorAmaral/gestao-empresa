generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Acesso & Auditoria ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("FUNCIONARIO") // ADMIN | FUNCIONARIO
  permissions  String   @default("vendas,os,clientes,produtos,estoque,compras,fornecedores")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  employee      Employee?
  sales         Sale[]
  purchases     Purchase[]
  movements     StockMovement[]
  serviceOrders ServiceOrder[]
  auditLogs     AuditLog[]
  receipts      GoodsReceipt[]
  productionOrders ProductionOrder[]
  invoices      Invoice[]
}

model CompanySettings {
  id                Int      @id @default(1)
  name              String   @default("GestãoPro Empresarial Ltda")
  tradeName         String?  @default("GestãoPro")
  logoUrl           String?  // URL da Logo ou imagem em base64 (data:image/...)
  primaryColor      String?  @default("#09090b") // Cor primária / botões principais
  sidebarColor      String?  @default("#09090b") // Cor da barra lateral / menu
  accentColor       String?  @default("#2563eb") // Cor de destaque / realce
  document          String?  @default("00.000.000/0001-00")
  stateRegistration String?
  email             String?  @default("contato@empresa.com.br")
  phone             String?  @default("(11) 3000-0000")
  website           String?
  address           String?  @default("Av. Paulista, 1000 — Bela Vista")
  city              String?  @default("São Paulo")
  state             String?  @default("SP")
  zipCode           String?  @default("01310-100")
  pixKey            String?  @default("00.000.000/0001-00")
  monthlyGoal       Float    @default(30000)
  receiptFooter     String?  @default("Obrigado pela preferência! Guarde este comprovante para garantia.")
  taxRegime         String?  @default("1") // 1=Simples Nacional, 2=Simples excesso, 3=Regime Normal
  nfeEnvironment    String?  @default("HOMOLOGACAO") // HOMOLOGACAO (2) | PRODUCAO (1)
  nfeSeries         Int?     @default(1)
  nfeNextNumber     Int?     @default(1)
  nfeApiProvider    String?  @default("FOCUS_NFE") // FOCUS_NFE | NUVEM_FISCAL | DIRETO_SEFAZ
  nfeApiKey         String?
  nfeCscId          String?
  nfeCscToken       String?
  ibgeCityCode      String?  @default("3550308") // Código IBGE do município
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  module    String // AUTH | CLIENTES | FORNECEDORES | PRODUTOS | ESTOQUE | VENDAS | COMPRAS | OS | FINANCEIRO | RH | USUARIOS | CONFIG
  action    String // CRIAR | EDITAR | EXCLUIR | CONFIRMAR | CANCELAR | RECEBER | BAIXAR | LOGIN
  entityId  String?
  details   String
  createdAt DateTime @default(now())
}

// ---------- Cadastros ----------

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  document  String? // CPF / CNPJ
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  ie        String?  // Inscrição Estadual (ou ISENTO)
  ieIndicator String? @default("9") // 1=Contribuinte, 2=Isento, 9=Não Contribuinte
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sales         Sale[]
  serviceOrders ServiceOrder[]
  invoices      Invoice[]
  contracts     Contract[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products  Product[]
  purchases Purchase[]
  receipts  GoodsReceipt[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  name        String
  description String?
  category    String?
  unit        String    @default("UN")
  costPrice   Float     @default(0)
  salePrice   Float     @default(0)
  stock       Float     @default(0)
  minStock    Float     @default(0)
  ncm         String?   @default("00000000") // NCM obrigatório 8 dígitos para NF-e
  cest        String?   // CEST 7 dígitos (se aplicável)
  cfop        String?   @default("5102")     // CFOP padrão de venda
  origin      String?   @default("0")        // 0=Nacional, 1=Importação direta, 2=Adquirida mercado interno
  csosn       String?   @default("102")      // Simples Nacional: 102 (sem permissão de crédito)
  active      Boolean   @default(true)
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  serviceOrderItems    ServiceOrderItem[]
  movements            StockMovement[]
  stockLocations       ProductStockLocation[]
  receiptItems         GoodsReceiptItem[]
  productionOrders     ProductionOrder[]     @relation("ProductProduction")
  productionOrderItems ProductionOrderItem[] @relation("ProductRawMaterial")
  recipeItems          ProductRecipeItem[]   @relation("ProductRecipe")
  usedInRecipes        ProductRecipeItem[]   @relation("ProductRecipeComponent")
  invoiceItems         InvoiceItem[]
}

model Employee {
  id                  Int       @id @default(autoincrement())
  name                String
  document            String?   // CPF
  rg                  String?
  pis                 String?   // PIS/PASEP/NIT (chave para sincronização com Relógio de Ponto REP/AFD)
  ctps                String?   // Nº e Série da CTPS
  birthDate           DateTime?
  email               String?
  phone               String?
  emergencyContact    String?
  position            String
  department          String?
  contractType        String    @default("CLT") // CLT | PJ | ESTAGIO | TEMPORARIO
  salary              Float     @default(0)
  workHoursPerDay     Float     @default(8)     // Jornada diária padrão (ex: 8h / 44h semanais)
  workSchedule        String?   @default("08:00 às 12:00 / 13:00 às 17:00")
  dependentsCount     Int       @default(0)     // Nº de dependentes para dedução de IRRF
  vrAmount            Float     @default(0)     // Vale-Refeição / Alimentação mensal (R$)
  vtDaily             Float     @default(0)     // Vale-Transporte diário (R$)
  vtOptIn             Boolean   @default(false) // Optante por VT (desconto legal até 6%)
  healthPlanDeduction Float     @default(0)     // Desconto mensal Plano de Saúde/Odonto (R$)
  hazardAdditionPct   Float     @default(0)     // Adicional Insalubridade/Periculosidade (%)
  bankInfo            String?                   // Banco / Agência / Conta
  pixKey              String?                   // Chave PIX do colaborador
  hireDate            DateTime
  active              Boolean   @default(true)
  notes               String?
  permissions         String    @default("vendas,os,clientes,produtos,estoque,compras,fornecedores")
  userId              Int?      @unique
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  serviceOrders       ServiceOrder[]
  timeClockLogs       TimeClockLog[]
  payrollEvents       EmployeePayrollEvent[]
  leaves              EmployeeLeave[]
  safetyRecords       EmployeeSafetyRecord[]
}

// ---------- RH & Departamento Pessoal: Relógios de Ponto (REP), Folha, Férias e SST ----------

model TimeClockMachine {
  id            Int            @id @default(autoincrement())
  name          String         // Ex: "Relógio Portaria Principal"
  brand         String         @default("CONTROL_ID") // CONTROL_ID | HENRY | TOPDATA | DIMEP | INTELBRAS
  model         String?        // Ex: "iDClass Bio", "Henry Prisma Super Fácil"
  serialNumber  String?        // Nº de fabricação REP (17 dígitos)
  ipAddress     String?        // Ex: "192.168.1.201"
  port          Int?           @default(443)
  apiToken      String         // Token de autenticação para Webhook / Push Sync
  location      String?        // Ex: "Entrada Fábrica / Recepção"
  status        String         @default("ONLINE") // ONLINE | OFFLINE | MANUTENCAO
  lastSyncAt    DateTime?
  totalSynced   Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  logs          TimeClockLog[]
}

model TimeClockLog {
  id              Int               @id @default(autoincrement())
  employeeId      Int
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  machineId       Int?
  machine         TimeClockMachine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  date            DateTime          // Data da batida (UTC midnight)
  nsr             String?           // Número Sequencial de Registro (AFD Portaria 671/1510)
  checkIn1        String?           // Ex: "08:00"
  checkOut1       String?           // Ex: "12:00"
  checkIn2        String?           // Ex: "13:00"
  checkOut2       String?           // Ex: "17:45"
  workedMinutes   Int               @default(480) // Total trabalhado em minutos
  expectedMinutes Int               @default(480) // Jornada esperada em minutos
  overtimeMinutes Int               @default(0)   // Horas extras apuradas no dia (min)
  lateMinutes     Int               @default(0)   // Atrasos / faltas no dia (min)
  source          String            @default("REP_AFD") // REP_AFD | WEBHOOK_API | AJUSTE_RH
  syncedToPayroll Boolean           @default(false)
  notes           String?
  createdAt       DateTime          @default(now())
}

model EmployeePayrollEvent {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String   // YYYY-MM (ex: "2026-11")
  type        String   // PROVENTO | DESCONTO
  category    String   // HORA_EXTRA | BONUS | COMISSAO | ADIANTAMENTO_VALE | FALTA_ATRASO | OUTROS
  description String
  reference   String?  // Ex: "12h 50%", "Vale 20/11", "2 dias"
  amount      Float
  financialId Int?     // Se gerou título no financeiro (ex: Vale Quinzenal)
  createdAt   DateTime @default(now())
}

model EmployeeLeave {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String    // FERIAS | ATESTADO_MEDICO | LICENCA | FALTA_INJUSTIFICADA
  startDate   DateTime
  endDate     DateTime
  days        Int       @default(1)
  cid         String?   // Código CID (para atestados)
  doctorName  String?   // Médico / CRM
  status      String    @default("APROVADO") // PROGRAMADA | EM_GOZO | CONCLUIDA | APROVADO
  vacationPay Float?    // Valor de férias + 1/3 (se tipo == FERIAS)
  notes       String?
  createdAt   DateTime  @default(now())
}

model EmployeeSafetyRecord {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordType  String    // EPI | ASO
  title       String    // Nome do EPI (ex: "Bota de Segurança") ou Tipo de Exame (ex: "ASO Periódico")
  caNumber    String?   // Certificado de Aprovação (para EPI) ou Resultado ("APTO")
  quantity    Int       @default(1)
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime? // Data de validade do EPI ou vencimento do ASO
  status      String    @default("VIGENTE") // VIGENTE | VENCIDO | DEVOLVIDO
  notes       String?
  createdAt   DateTime  @default(now())
}

// ---------- Movimentações ----------

model Sale {
  id            Int      @id @default(autoincrement())
  clientId      Int?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  status        String   @default("ORCAMENTO") // ORCAMENTO | CONFIRMADA | CANCELADA
  paymentMethod String?
  installments  Int      @default(1)
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  total         Float    @default(0)
  notes         String?
  approvedAt    DateTime?
  clientNotes   String?
  pipelineStage String?  @default("PROPOSTA") // NOVO_LEAD | CONTATO | PROPOSTA | NEGOCIACAO | FECHADO | PERDIDO
  lossReason    String?
  createdAt     DateTime @default(now())

  items     SaleItem[]
  financial FinancialEntry[]
  invoices  Invoice[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float
}

model Purchase {
  id         Int       @id @default(autoincrement())
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date       DateTime  @default(now())
  dueDate    DateTime?
  receivedAt DateTime?
  status     String    @default("PENDENTE") // PENDENTE | RECEBIDA | CANCELADA
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())

  items     PurchaseItem[]
  financial FinancialEntry[]
  receipts  GoodsReceipt[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitCost   Float
  total      Float
}

model ServiceOrder {
  id             Int       @id @default(autoincrement())
  clientId       Int?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  technicianId   Int?
  technician     Employee? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  equipment      String // Equipamento / Objeto do serviço
  serialNumber   String?
  reportedIssue  String // Defeito / solicitação relatada
  diagnosis      String? // Diagnóstico / serviço executado
  priority       String    @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status         String    @default("ABERTA") // ABERTA | EM_ANDAMENTO | AGUARDANDO_PECA | CONCLUIDA | CANCELADA
  paymentMethod  String?
  openedAt       DateTime  @default(now())
  expectedDate   DateTime?
  completedAt    DateTime?
  laborCost      Float     @default(0) // Mão de obra
  partsSubtotal  Float     @default(0) // Peças / produtos
  discount       Float     @default(0)
  total          Float     @default(0)
  notes          String?
  approvedAt     DateTime?
  clientNotes    String?
  createdAt      DateTime  @default(now())

  items     ServiceOrderItem[]
  financial FinancialEntry[]
}

model ServiceOrderItem {
  id             Int          @id @default(autoincrement())
  serviceOrderId Int
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Float
  unitPrice      Float
  total          Float
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // ENTRADA | SAIDA | AJUSTE
  quantity  Float
  reason    String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model BankAccount {
  id             Int              @id @default(autoincrement())
  name           String           // Ex: "Caixa Físico", "Banco Itaú", "Nubank PJ"
  bankName       String?          // Ex: "341 - Itaú Unibanco", "260 - Nu Pagamentos"
  agency         String?
  accountNumber  String?
  type           String           @default("CORRENTE") // CAIXA | CORRENTE | DIGITAL | INVESTIMENTO
  initialBalance Float            @default(0)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())

  entries        FinancialEntry[]
}

model CashSession {
  id             Int       @id @default(autoincrement())
  userId         Int?
  userName       String
  status         String    @default("ABERTO") // ABERTO | FECHADO
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Float     @default(0)
  closingBalance Float?
  totalCash      Float     @default(0)
  totalPix       Float     @default(0)
  totalCard      Float     @default(0)
  totalOther     Float     @default(0)
  withdrawals    Float     @default(0)
  supplies       Float     @default(0)
  salesCount     Int       @default(0)
  notes          String?
}

model FinancialEntry {
  id                Int           @id @default(autoincrement())
  type              String // RECEITA | DESPESA
  description       String
  category          String?
  amount            Float
  dueDate           DateTime
  paidAt            DateTime?
  status            String        @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  notes             String?
  bankAccountId     Int?
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  installmentNumber Int?
  installmentTotal  Int?
  recurrenceGroup   String?
  ofxFitId          String?
  saleId            Int?
  sale              Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseId        Int?
  purchase          Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  serviceOrderId    Int?
  serviceOrder      ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
}

// ---------- Endereçamento de Estoque / Localização de Produtos ----------

model StockLocation {
  id          Int                    @id @default(autoincrement())
  code        String                 @unique // Código do endereço (ex.: "A-01-02-01" ou "RUA-A-01")
  aisle       String?                // Corredor / Rua / Galpão (ex: "Rua A", "Galpão 1")
  rack        String?                // Prateleira / Estante / Módulo (ex: "Estante 01")
  shelf       String?                // Nível / Andar (ex: "Nível 02")
  bin         String?                // Vão / Gaveta / Posição (ex: "Gaveta 01")
  description String?                // Descrição adicional / observações (ex: "Área de picking")
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())

  items                ProductStockLocation[]
  receiptItems         GoodsReceiptItem[]
  productionOrderItems ProductionOrderItem[]
}

model ProductStockLocation {
  id         Int           @id @default(autoincrement())
  productId  Int
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId Int
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Float         @default(0) // Quantidade do produto guardada neste endereço específico
  notes      String?       // Observações (ex.: Lote, Caixa, Validade)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())

  @@unique([productId, locationId])
}

// ---------- Recebimento de Mercadorias & Matérias-Primas ----------

model GoodsReceipt {
  id            Int                @id @default(autoincrement())
  code          String             @unique // ex: "REC-001"
  invoiceNumber String?            // Número da Nota Fiscal (NF-e)
  supplierId    Int?
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseId    Int?
  purchase      Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status        String             @default("RECEBIDO") // PENDENTE | RECEBIDO | CANCELADO
  receivedAt    DateTime           @default(now())
  notes         String?
  userId        Int?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id         Int            @id @default(autoincrement())
  receiptId  Int
  receipt    GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product        @relation(fields: [productId], references: [id])
  quantity   Float          // Quantidade recebida
  unitCost   Float          @default(0)
  locationId Int?           // Endereço de estoque onde foi armazenado
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batch      String?        // Lote do fabricante
  notes      String?
}

// ---------- Ordens de Produção (OP) ----------

model ProductionOrder {
  id           Int                   @id @default(autoincrement())
  code         String                @unique // ex: "OP-001"
  productId    Int                   // Produto Final a Fabricar
  product      Product               @relation("ProductProduction", fields: [productId], references: [id])
  quantity     Float                 // Quantidade planejada a produzir
  machine      String                // Máquina / Posto de trabalho / Linha de entrega
  operatorName String?               // Operador responsável pela máquina
  priority     String                @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status       String                @default("PLANEJADA") // PLANEJADA | EM_PRODUCAO | CONCLUIDA | CANCELADA
  startDate        DateTime?             // Início da produção
  deliveryDate     DateTime?             // Previsão de entrega dos materiais na máquina
  completedAt      DateTime?             // Conclusão da produção
  producedQuantity Float?                // Quantidade boa efetivamente produzida
  scrapQuantity    Float                 @default(0) // Quantidade descartada (refugo / perda)
  actualMinutes    Int?                  // Tempo gasto na máquina (em minutos)
  scrapReason      String?               // Motivo de refugo / perda
  notes            String?               // Instruções técnicas / operacionais
  userId       Int?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  items        ProductionOrderItem[]
}

model ProductionOrderItem {
  id                Int              @id @default(autoincrement())
  productionOrderId Int
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         Int              // Insumo / Matéria-prima necessária
  product           Product          @relation("ProductRawMaterial", fields: [productId], references: [id])
  quantityRequired  Float            // Quantidade total necessária para a OP
  locationId        Int?             // Endereço de estoque de onde retirar
  location          StockLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes             String?
}

// ---------- Ficha Técnica / Receita de Produção (BOM) ----------

model ProductRecipeItem {
  id          Int      @id @default(autoincrement())
  productId   Int      // Produto final fabricado
  product     Product  @relation("ProductRecipe", fields: [productId], references: [id], onDelete: Cascade)
  componentId Int      // Insumo / Matéria-prima necessária
  component   Product  @relation("ProductRecipeComponent", fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Float    @default(1) // Quantidade necessária para produzir 1 UN do produto final
  notes       String?  // Especificações técnicas / tolerâncias
  createdAt   DateTime @default(now())

  @@unique([productId, componentId])
}

// ---------- Cadastro de Máquinas / Postos de Trabalho ----------

model ProductionMachine {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Ex: "Torno CNC 01"
  code      String?  // Ex: "M-01"
  category  String?  // Ex: "Usinagem", "Injeção", "Montagem", "Solda"
  location  String?  // Ex: "Galpão A - Setor 2"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Notas Fiscais Eletrônicas (NF-e Modelo 55) ----------

model Invoice {
  id              Int       @id @default(autoincrement())
  number          Int       // Número da NF-e (1, 2, 3...)
  series          Int       @default(1)
  type            String    @default("SAIDA") // SAIDA (1) | ENTRADA (0)
  status          String    @default("RASCUNHO") // RASCUNHO | PROCESSANDO | AUTORIZADA | CANCELADA | REJEITADA
  environment     String    @default("HOMOLOGACAO") // HOMOLOGACAO (2) | PRODUCAO (1)

  saleId          Int?
  sale            Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  clientId        Int?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // SEFAZ / Protocolo Oficial
  accessKey       String?   @unique // Chave de acesso de 44 dígitos
  protocol        String?   // Número do protocolo de autorização SEFAZ (ex: 135260000000001)
  authorizedAt    DateTime?
  cStat           String?   // Código status SEFAZ (100 = Autorizado)
  xMotivo         String?   // Motivo de status SEFAZ
  xmlUrl          String?   // URL para download do XML
  danfeUrl        String?   // URL do PDF DANFE
  xmlContent      String?   // XML oficial assinado com tag protNFe

  canceledAt      DateTime?
  cancelReason    String?

  // Valores Totais
  totalProducts   Float     @default(0)
  totalDiscount   Float     @default(0)
  totalFreight    Float     @default(0)
  totalInvoice    Float     @default(0)

  // Tributos
  baseIcms        Float     @default(0)
  valueIcms       Float     @default(0)
  valuePis        Float     @default(0)
  valueCofins     Float     @default(0)
  approxTaxTotal  Float     @default(0) // Lei da Transparência IBPT

  // Transporte
  freightModality String    @default("9") // 9=Sem Frete, 0=Remetente (CIF), 1=Destinatário (FOB)
  carrierName     String?

  fiscalNotes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  itemNumber  Int     @default(1)

  sku         String?
  name        String
  ncm         String  @default("00000000")
  cfop        String  @default("5102")
  unit        String  @default("UN")
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  discount    Float   @default(0)

  origin      String  @default("0")
  csosn       String? @default("102")
  icmsRate    Float   @default(0)
  icmsValue   Float   @default(0)
  pisRate     Float   @default(0)
  pisValue    Float   @default(0)
  cofinsRate  Float   @default(0)
  cofinsValue Float   @default(0)
}

// ---------- Contratos & Mensalidades Recorrentes (Assinaturas) ----------

model Contract {
  id                   Int       @id @default(autoincrement())
  clientId             Int
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                String    // Ex: "Contrato Suporte e Manutenção TI"
  description          String?
  amount               Float     @default(0)
  recurrence           String    @default("MENSAL") // MENSAL | TRIMESTRAL | SEMESTRAL | ANUAL
  dueDay               Int       @default(10) // Dia de vencimento (1 a 31)
  status               String    @default("ATIVO") // ATIVO | PAUSADO | CANCELADO
  autoGenerateFinEntry Boolean   @default(true)
  autoGenerateOS       Boolean   @default(false)
  osServiceDescription String?
  startDate            DateTime  @default(now())
  endDate              DateTime?
  lastBilledAt         DateTime?
  nextBillingDate      DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ---------- Helpdesk & Chamados de Suporte TI ----------

model ItTicket {
  id             Int       @id @default(autoincrement())
  ticketNumber   String    @unique
  requesterName  String
  requesterEmail String?
  requesterPhone String?
  department     String?
  category       String    @default("OUTRO") // ACESSO_SENHA | SISTEMA_ERRO | EQUIPAMENTO_HARDWARE | REDE_INTERNET | INSTALACAO_SOFTWARE | OUTRO
  priority       String    @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status         String    @default("ABERTO") // ABERTO | EM_ATENDIMENTO | RESOLVIDO | CANCELADO
  title          String
  description    String
  solutionNotes  String?
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------- Gestão de Ativos & Equipamentos de TI ----------

model ItAsset {
  id             Int       @id @default(autoincrement())
  assetTag       String    @unique
  name           String
  category       String    @default("NOTEBOOK") // NOTEBOOK | DESKTOP | MONITOR | IMPRESSORA | SERVIDOR | REDE | OUTRO
  serialNumber   String?
  assignedUser   String?
  department     String?
  status         String    @default("EM_USO") // EM_USO | DISPONIVEL | MANUTENCAO | BAIXADO
  specifications String?
  purchaseDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}



