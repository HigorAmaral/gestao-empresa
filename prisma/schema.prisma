generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Acesso & Auditoria ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("FUNCIONARIO") // ADMIN | FUNCIONARIO
  permissions  String   @default("vendas,os,clientes,produtos,estoque,compras,fornecedores")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  employee      Employee?
  sales         Sale[]
  purchases     Purchase[]
  movements     StockMovement[]
  serviceOrders ServiceOrder[]
  auditLogs     AuditLog[]
  receipts      GoodsReceipt[]
  productionOrders ProductionOrder[]
}

model CompanySettings {
  id                Int      @id @default(1)
  name              String   @default("GestãoPro Empresarial Ltda")
  tradeName         String?  @default("GestãoPro")
  logoUrl           String?  // URL da Logo ou imagem em base64 (data:image/...)
  primaryColor      String?  @default("#09090b") // Cor primária / botões principais
  sidebarColor      String?  @default("#09090b") // Cor da barra lateral / menu
  accentColor       String?  @default("#2563eb") // Cor de destaque / realce
  document          String?  @default("00.000.000/0001-00")
  stateRegistration String?
  email             String?  @default("contato@empresa.com.br")
  phone             String?  @default("(11) 3000-0000")
  website           String?
  address           String?  @default("Av. Paulista, 1000 — Bela Vista")
  city              String?  @default("São Paulo")
  state             String?  @default("SP")
  zipCode           String?  @default("01310-100")
  pixKey            String?  @default("00.000.000/0001-00")
  monthlyGoal       Float    @default(30000)
  receiptFooter     String?  @default("Obrigado pela preferência! Guarde este comprovante para garantia.")
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  module    String // AUTH | CLIENTES | FORNECEDORES | PRODUTOS | ESTOQUE | VENDAS | COMPRAS | OS | FINANCEIRO | RH | USUARIOS | CONFIG
  action    String // CRIAR | EDITAR | EXCLUIR | CONFIRMAR | CANCELAR | RECEBER | BAIXAR | LOGIN
  entityId  String?
  details   String
  createdAt DateTime @default(now())
}

// ---------- Cadastros ----------

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  document  String? // CPF / CNPJ
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sales         Sale[]
  serviceOrders ServiceOrder[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products  Product[]
  purchases Purchase[]
  receipts  GoodsReceipt[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  name        String
  description String?
  category    String?
  unit        String    @default("UN")
  costPrice   Float     @default(0)
  salePrice   Float     @default(0)
  stock       Float     @default(0)
  minStock    Float     @default(0)
  active      Boolean   @default(true)
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  serviceOrderItems    ServiceOrderItem[]
  movements            StockMovement[]
  stockLocations       ProductStockLocation[]
  receiptItems         GoodsReceiptItem[]
  productionOrders     ProductionOrder[]     @relation("ProductProduction")
  productionOrderItems ProductionOrderItem[] @relation("ProductRawMaterial")
  recipeItems          ProductRecipeItem[]   @relation("ProductRecipe")
  usedInRecipes        ProductRecipeItem[]   @relation("ProductRecipeComponent")
}

model Employee {
  id          Int      @id @default(autoincrement())
  name        String
  document    String?
  email       String?
  phone       String?
  position    String
  department  String?
  salary      Float    @default(0)
  hireDate    DateTime
  active      Boolean  @default(true)
  notes       String?
  permissions String   @default("vendas,os,clientes,produtos,estoque,compras,fornecedores")
  userId      Int?     @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  serviceOrders ServiceOrder[]
}

// ---------- Movimentações ----------

model Sale {
  id            Int      @id @default(autoincrement())
  clientId      Int?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  status        String   @default("ORCAMENTO") // ORCAMENTO | CONFIRMADA | CANCELADA
  paymentMethod String?
  installments  Int      @default(1)
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  total         Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  items     SaleItem[]
  financial FinancialEntry[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float
}

model Purchase {
  id         Int       @id @default(autoincrement())
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date       DateTime  @default(now())
  dueDate    DateTime?
  receivedAt DateTime?
  status     String    @default("PENDENTE") // PENDENTE | RECEBIDA | CANCELADA
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())

  items     PurchaseItem[]
  financial FinancialEntry[]
  receipts  GoodsReceipt[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitCost   Float
  total      Float
}

model ServiceOrder {
  id             Int       @id @default(autoincrement())
  clientId       Int?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  technicianId   Int?
  technician     Employee? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  equipment      String // Equipamento / Objeto do serviço
  serialNumber   String?
  reportedIssue  String // Defeito / solicitação relatada
  diagnosis      String? // Diagnóstico / serviço executado
  priority       String    @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status         String    @default("ABERTA") // ABERTA | EM_ANDAMENTO | AGUARDANDO_PECA | CONCLUIDA | CANCELADA
  paymentMethod  String?
  openedAt       DateTime  @default(now())
  expectedDate   DateTime?
  completedAt    DateTime?
  laborCost      Float     @default(0) // Mão de obra
  partsSubtotal  Float     @default(0) // Peças / produtos
  discount       Float     @default(0)
  total          Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  items     ServiceOrderItem[]
  financial FinancialEntry[]
}

model ServiceOrderItem {
  id             Int          @id @default(autoincrement())
  serviceOrderId Int
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Float
  unitPrice      Float
  total          Float
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // ENTRADA | SAIDA | AJUSTE
  quantity  Float
  reason    String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model FinancialEntry {
  id             Int           @id @default(autoincrement())
  type           String // RECEITA | DESPESA
  description    String
  category       String?
  amount         Float
  dueDate        DateTime
  paidAt         DateTime?
  status         String        @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  notes          String?
  saleId         Int?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseId     Int?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  serviceOrderId Int?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

// ---------- Endereçamento de Estoque / Localização de Produtos ----------

model StockLocation {
  id          Int                    @id @default(autoincrement())
  code        String                 @unique // Código do endereço (ex.: "A-01-02-01" ou "RUA-A-01")
  aisle       String?                // Corredor / Rua / Galpão (ex: "Rua A", "Galpão 1")
  rack        String?                // Prateleira / Estante / Módulo (ex: "Estante 01")
  shelf       String?                // Nível / Andar (ex: "Nível 02")
  bin         String?                // Vão / Gaveta / Posição (ex: "Gaveta 01")
  description String?                // Descrição adicional / observações (ex: "Área de picking")
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())

  items                ProductStockLocation[]
  receiptItems         GoodsReceiptItem[]
  productionOrderItems ProductionOrderItem[]
}

model ProductStockLocation {
  id         Int           @id @default(autoincrement())
  productId  Int
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId Int
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Float         @default(0) // Quantidade do produto guardada neste endereço específico
  notes      String?       // Observações (ex.: Lote, Caixa, Validade)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())

  @@unique([productId, locationId])
}

// ---------- Recebimento de Mercadorias & Matérias-Primas ----------

model GoodsReceipt {
  id            Int                @id @default(autoincrement())
  code          String             @unique // ex: "REC-001"
  invoiceNumber String?            // Número da Nota Fiscal (NF-e)
  supplierId    Int?
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseId    Int?
  purchase      Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status        String             @default("RECEBIDO") // PENDENTE | RECEBIDO | CANCELADO
  receivedAt    DateTime           @default(now())
  notes         String?
  userId        Int?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id         Int            @id @default(autoincrement())
  receiptId  Int
  receipt    GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product        @relation(fields: [productId], references: [id])
  quantity   Float          // Quantidade recebida
  unitCost   Float          @default(0)
  locationId Int?           // Endereço de estoque onde foi armazenado
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batch      String?        // Lote do fabricante
  notes      String?
}

// ---------- Ordens de Produção (OP) ----------

model ProductionOrder {
  id           Int                   @id @default(autoincrement())
  code         String                @unique // ex: "OP-001"
  productId    Int                   // Produto Final a Fabricar
  product      Product               @relation("ProductProduction", fields: [productId], references: [id])
  quantity     Float                 // Quantidade planejada a produzir
  machine      String                // Máquina / Posto de trabalho / Linha de entrega
  operatorName String?               // Operador responsável pela máquina
  priority     String                @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status       String                @default("PLANEJADA") // PLANEJADA | EM_PRODUCAO | CONCLUIDA | CANCELADA
  startDate    DateTime?             // Início da produção
  deliveryDate DateTime?             // Previsão de entrega dos materiais na máquina
  completedAt  DateTime?             // Conclusão da produção
  notes        String?               // Instruções técnicas / operacionais
  userId       Int?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  items        ProductionOrderItem[]
}

model ProductionOrderItem {
  id                Int              @id @default(autoincrement())
  productionOrderId Int
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         Int              // Insumo / Matéria-prima necessária
  product           Product          @relation("ProductRawMaterial", fields: [productId], references: [id])
  quantityRequired  Float            // Quantidade total necessária para a OP
  locationId        Int?             // Endereço de estoque de onde retirar
  location          StockLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes             String?
}

// ---------- Ficha Técnica / Receita de Produção (BOM) ----------

model ProductRecipeItem {
  id          Int      @id @default(autoincrement())
  productId   Int      // Produto final fabricado
  product     Product  @relation("ProductRecipe", fields: [productId], references: [id], onDelete: Cascade)
  componentId Int      // Insumo / Matéria-prima necessária
  component   Product  @relation("ProductRecipeComponent", fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Float    @default(1) // Quantidade necessária para produzir 1 UN do produto final
  notes       String?  // Especificações técnicas / tolerâncias
  createdAt   DateTime @default(now())

  @@unique([productId, componentId])
}

// ---------- Cadastro de Máquinas / Postos de Trabalho ----------

model ProductionMachine {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Ex: "Torno CNC 01"
  code      String?  // Ex: "M-01"
  category  String?  // Ex: "Usinagem", "Injeção", "Montagem", "Solda"
  location  String?  // Ex: "Galpão A - Setor 2"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

